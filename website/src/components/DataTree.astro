---
// File modified from https://github.com/withastro/starlight/blob/main/packages/starlight/user-components/FileTree.astro
import { processFileTree } from './rehype-data-tree';

const fileTreeHtml = await Astro.slots.render('default');
const html = processFileTree(fileTreeHtml, Astro.locals.t('fileTree.directory'));
---

<starlight-data-tree set:html={html} class="not-content" data-pagefind-ignore />

<style>
    @layer starlight.components {
        starlight-data-tree {
            --x-space: 1.5rem;
            --y-space: 0.125rem;
            --y-pad: 0;

            display: block;
            border: 1px solid var(--sl-color-gray-5);
            padding: 1rem;
            background-color: var(--sl-color-gray-6);
            font-size: var(--sl-text-xs);
            font-family: var(--__sl-font-mono);
            overflow-x: auto;
        }

        starlight-data-tree :global(.directory > details) {
            border: 0;
            padding: 0;
            padding-inline-start: var(--x-space);
            background: transparent;
        }

        starlight-data-tree :global(.directory > details > summary) {
            margin-inline-start: calc(-1 * var(--x-space));
            border: 0;
            padding: var(--y-pad) 0.625rem;
            font-weight: normal;
            color: var(--sl-color-white);
            max-width: 100%;
        }

        starlight-data-tree :global(.directory > details > summary::marker),
        starlight-data-tree :global(.directory > details > summary::-webkit-details-marker) {
            color: var(--sl-color-gray-3);
        }

        starlight-data-tree :global(.directory > details > summary:hover),
        starlight-data-tree :global(.directory > details > summary:hover .tree-icon) {
            cursor: pointer;
            color: var(--sl-color-text-accent);
            fill: currentColor;
        }

        starlight-data-tree :global(.directory > details > summary:hover ~ ul) {
            border-color: var(--sl-color-gray-4);
        }

        starlight-data-tree :global(.directory > details > summary:hover .highlight .tree-icon) {
            color: var(--sl-color-text-invert);
            fill: currentColor;
        }

        starlight-data-tree :global(ul) {
            margin-inline-start: 0.5rem;
            border-inline-start: 1px solid var(--sl-color-gray-5);
            padding: 0;
            padding-inline-start: 0.125rem;
            list-style: none;
        }

        starlight-data-tree > :global(ul) {
            margin: 0;
            border: 0;
            padding: 0;
        }

        starlight-data-tree :global(li) {
            margin: var(--y-space) 0;
            padding: var(--y-pad) 0;
        }

        starlight-data-tree :global(.file) {
            margin-inline-start: calc(var(--x-space) - 0.125rem);
            color: var(--sl-color-white);
        }

        starlight-data-tree :global(.tree-entry) {
            display: inline-flex;
            align-items: flex-start;
            flex-wrap: wrap;
            max-width: calc(100% - 1rem);
        }

        @media (min-width: 30em) {
            starlight-data-tree :global(.tree-entry) {
                flex-wrap: nowrap;
            }
        }

        starlight-data-tree :global(.tree-entry > :first-child) {
            flex-shrink: 0;
        }

        starlight-data-tree :global(.empty) {
            color: var(--sl-color-gray-3);
            padding-inline-start: 0.375rem;
        }

        starlight-data-tree :global(.comment) {
            color: var(--sl-color-gray-3);
            padding-inline-start: 1.625rem;
            max-width: 24rem;
            min-width: 12rem;
        }

        starlight-data-tree :global(.highlight) {
            display: inline-block;
            border-radius: 0.25rem;
            padding-inline-end: 0.5rem;
            color: var(--sl-color-text-invert);
            background-color: var(--sl-color-text-accent);
        }

        starlight-data-tree :global(svg) {
            display: inline;
            fill: var(--sl-color-gray-3);
            vertical-align: middle;
            margin-inline: 0.25rem 0.375rem;
            width: 0.875rem;
            height: 0.875rem;
        }

        starlight-data-tree :global(.highlight svg.tree-icon) {
            fill: currentColor;
        }
    }
</style>