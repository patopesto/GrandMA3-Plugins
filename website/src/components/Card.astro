---
// File modified from https://github.com/withastro/starlight/blob/main/packages/starlight/user-components/Card.astro
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/types';

interface Props {
    icon?: StarlightIcon;
    title: string;
    href?: string | URL;
}

const { icon, title, href } = Astro.props;
---

<a class="card sl-flex hidden-link" href={href}>
    <p class="title sl-flex">
        {icon && <Icon name={icon} class="icon" size="1.333em" />}
        <span set:html={title} />
    </p>
    <div class="body"><slot /></div>
</a>

<style>
    @layer starlight.components {
        .card {
            --sl-card-border: var(--sl-color-purple);
            --sl-card-bg: var(--sl-color-purple-low);
            border: 1px solid var(--sl-color-gray-5);
            background-color: var(--sl-color-black);
            padding: clamp(1rem, calc(0.125rem + 3vw), 2.5rem);
            flex-direction: column;
            gap: clamp(0.5rem, calc(0.125rem + 1vw), 1rem);
            border-radius: 1rem;

            transition-property: background-color, border-color, color;
            transition-duration: 250ms;
            transition-timing-function: linear;
        }
        .card:nth-child(4n + 1) {
            --sl-card-border: var(--sl-color-orange);
            --sl-card-bg: var(--sl-color-orange-low);
        }
        .card:nth-child(4n + 3) {
            --sl-card-border: var(--sl-color-green);
            --sl-card-bg: var(--sl-color-green-low);
        }
        .card:nth-child(4n + 4) {
            --sl-card-border: var(--sl-color-red);
            --sl-card-bg: var(--sl-color-red-low);
        }
        .card:nth-child(4n + 5) {
            --sl-card-border: var(--sl-color-blue);
            --sl-card-bg: var(--sl-color-blue-low);
        }
        .card:hover {
            color: var(--sl-color-white);
            background-color: var(--sl-color-gray-6);
            border-color: var(--sl-color-gray-4);
            /*transition: none;*/
            /*background-image: linear-gradient(var(--sl-color-black), var(--sl-color-gray-6));*/
        }
        .title {
            font-weight: 600;
            font-size: var(--sl-text-h4);
            color: var(--sl-color-white);
            line-height: var(--sl-line-height-headings);
            gap: 1rem;
            align-items: center;
        }
        .card .icon {
            border: 1px solid var(--sl-card-border);
            background-color: var(--sl-card-bg);
            padding: 0.2em;
            border-radius: 0.25rem;
            flex-shrink: 0;
        }
        .card .body {
            margin: 0;
            font-size: clamp(var(--sl-text-sm), calc(0.5rem + 1vw), var(--sl-text-body));
        }
        .hidden-link {
            text-decoration: none;
            color: inherit;
        }
    }
</style>