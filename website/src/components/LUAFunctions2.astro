---
import { getCollection, render } from 'astro:content';

// Grab **all** entries from the `grandma` collection.
// They are already sorted alphabetically by slug (function name).
const allFuncs = await getCollection('grandma');

// Helper to create stable IDs for the TOC (optional but nice).
function slugify(str: string) {
  return str
    .toLowerCase()
    .replace(/[^\w]+/g, '-')
    .replace(/^-+|-+$/g, '');
}
---
<section>
  <h1 id="grandma-api-reference">grandMA 3 Lua API Reference</h1>

  <!-- Object‑Free API -->
  <section>
    <h2 id={slugify('Object‑Free API')}>Object‑Free API</h2>

    {allFuncs
      .filter((entry) => entry.data.section === 'objectfree')
      .map((entry) => (
        <article key={entry.slug}>
          {/* The entry already contains a level‑3 heading in its body,
              but we also expose a clean <h3> for extra accessibility. */}
          <h3 id={slugify(entry.data.title)}>{entry.data.title}</h3>

          {/* Render the Markdown body that we generated in the collection.
              Astro will automatically transform it to HTML. */}

          {/*<div set:html={render(entry)} />*/}
          {/*<div set:html={render(entry)} />*/}
          <div>{entry.rendered}</div>

          {/* If you ever need the raw data (e.g. for a table view elsewhere),
              it’s available via entry.data */}
        </article>
      ))}
  </section>

  <!-- Object API -->
  <section>
    <h2 id={slugify('Object API')}>Object API</h2>

    {allFuncs
      .filter((entry) => entry.data.section === 'object')
      .map((entry) => (
        <article key={entry.slug}>
          <h3 id={slugify(entry.data.title)}>{entry.data.title}</h3>
          <div set:html={entry.body} />
        </article>
      ))}
  </section>
</section>